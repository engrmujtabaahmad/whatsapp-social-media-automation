    {
      "parameters": {
        "jsCode": "const entry = $json.body.entry[0].changes[0].value;\n\nif (!entry.messages) {\n  return []; // status update hai, actual message nahi\n}\n\nconst msg = entry.messages[0];\nconst senderNumber = msg.from;\nconst messageType = msg.type; // \"text\", \"image\", \"video\" etc.\n\nlet mediaId = null;\nlet caption = null;\n\nif (messageType === 'image') {\n  mediaId = msg.image.id;\n  caption = msg.image.caption || '';\n} else if (messageType === 'video') {\n  mediaId = msg.video.id;\n  caption = msg.video.caption || '';\n} else if (messageType === 'text') {\n  caption = msg.text.body;\n}\n\nreturn [{\n  json: {\n    sender: senderNumber,\n    messageType,\n    mediaId,\n    caption\n  }\n}];"
      },
